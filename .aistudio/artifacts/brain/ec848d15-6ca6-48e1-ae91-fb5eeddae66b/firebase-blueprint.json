{
  "entities": {
    "MedicalDeviceItem": {
      "title": "MedicalDeviceItem",
      "description": "User-specific medical device inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "material": { "type": "string" },
        "materialDescription": { "type": "string" },
        "qty": { "type": "number" },
        "plant": { "type": "string" },
        "plantName": { "type": "string" },
        "wh": { "type": "string" },
        "storageLocation": { "type": "string" },
        "totalAmount": { "type": "number" },
        "unitPrice": { "type": "number" },
        "stockType": { "type": "string" },
        "specialStockType": { "type": "string" },
        "batch": { "type": "string" },
        "expiryDate": { "type": "string" },
        "wbsElement": { "type": "string" },
        "manufacturer": { "type": "string" },
        "materialType": { "type": "string" },
        "isNotFunctional": { "type": "boolean" },
        "needsSparePart": { "type": "boolean" },
        "isNonMoving": { "type": "boolean" },
        "hasDSP": { "type": "boolean" },
        "installationStatus": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "sohStatus": { "type": "string" },
        "syncStatus": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "material"]
    },
    "HealthFacilityRecord": {
      "title": "HealthFacilityRecord",
      "description": "Master list of health facilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customer": { "type": "string" },
        "customerDescription": { "type": "string" },
        "facilityType": { "type": "string" },
        "deliveringPlant": { "type": "string" },
        "ownershipCode": { "type": "string" },
        "ownershipDescription": { "type": "string" },
        "region": { "type": "string" },
        "zoneCode": { "type": "string" },
        "zoneDescription": { "type": "string" },
        "woreda": { "type": "string" },
        "woredaDescription": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "customer", "customerDescription"]
    },
    "MaterialMasterRecord": {
      "title": "MaterialMasterRecord",
      "description": "Product master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "product": { "type": "string" },
        "material": { "type": "string" },
        "plant": { "type": "string" },
        "productType": { "type": "string" },
        "productGroup": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "material", "product"]
    },
    "MultipleStockRecord": {
      "title": "MultipleStockRecord",
      "description": "Detailed stock records across locations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "material": { "type": "string" },
        "materialDescription": { "type": "string" },
        "plant": { "type": "string" },
        "storageLocation": { "type": "string" },
        "unrestrictedStock": { "type": "number" },
        "currentValueOfUnrestrictedStock": { "type": "number" },
        "wbsElement": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "material"]
    },
    "ReceivingDataRecord": {
      "title": "ReceivingDataRecord",
      "description": "Records of items received in warehouses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "purchaseOrder": { "type": "string" },
        "material": { "type": "string" },
        "quantity": { "type": "number" },
        "plant": { "type": "string" },
        "postingDate": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "purchaseOrder", "material"]
    },
    "DistributionDataRecord": {
      "title": "DistributionDataRecord",
      "description": "Records of items distributed to facilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plant": { "type": "string" },
        "customerName": { "type": "string" },
        "materialCode": { "type": "string" },
        "quantity": { "type": "number" },
        "deliveryDate": { "type": "string" },
        "podStatus": { "type": "string" }
      },
      "required": ["id", "customerName", "materialCode"]
    },
    "ProgramMdRecord": {
      "title": "ProgramMdRecord",
      "description": "Program-specific medical device records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sapPo": { "type": "string" },
        "itemDescription": { "type": "string" },
        "quantity": { "type": "number" },
        "supplier": { "type": "string" },
        "deviceOwner": { "type": "string" },
        "requestYear": { "type": "string" }
      },
      "required": ["id", "sapPo", "itemDescription"]
    },
    "DspWorkflowRecord": {
      "title": "DspWorkflowRecord",
      "description": "Workflow dossiers for distribution planning",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dspRefNumber": { "type": "string" },
        "stage": { "type": "string" },
        "status": { "type": "string" },
        "subject": { "type": "string" },
        "totalQuantity": { "type": "number" },
        "dateSubmitted": { "type": "string" }
      },
      "required": ["id", "dspRefNumber", "stage"]
    },
    "MasterDataLog": {
      "title": "MasterDataLog",
      "description": "Log entry for master data uploads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "fileName": { "type": "string" },
        "rowCount": { "type": "number" },
        "uploadedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "type", "fileName", "uploadedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/inventory/{itemId}": {
      "schema": { "$ref": "MedicalDeviceItem" },
      "description": "User-specific inventory collection"
    },
    "/users/{userId}/healthFacilities/{hfId}": {
      "schema": { "$ref": "HealthFacilityRecord" },
      "description": "Master list of health facilities"
    },
    "/users/{userId}/materialMaster/{matId}": {
      "schema": { "$ref": "MaterialMasterRecord" },
      "description": "Material master data"
    },
    "/users/{userId}/multipleStock/{stockId}": {
      "schema": { "$ref": "MultipleStockRecord" },
      "description": "Detailed stock ledger"
    },
    "/users/{userId}/receivingData/{recId}": {
      "schema": { "$ref": "ReceivingDataRecord" },
      "description": "Warehouse receiving logs"
    },
    "/users/{userId}/distributionData/{distId}": {
      "schema": { "$ref": "DistributionDataRecord" },
      "description": "Distribution and POD logs"
    },
    "/users/{userId}/programMdRecords/{progId}": {
      "schema": { "$ref": "ProgramMdRecord" },
      "description": "Program-specific records"
    },
    "/users/{userId}/dspWorkflows/{dspId}": {
      "schema": { "$ref": "DspWorkflowRecord" },
      "description": "Distribution Planning dossiers"
    },
    "/users/{userId}/masterDataLogs/{logId}": {
      "schema": { "$ref": "MasterDataLog" },
      "description": "Audit logs for data operations"
    }
  }
}
