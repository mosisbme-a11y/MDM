rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidMedicalDeviceItem(data) {
      return data.keys().hasAll(['id', 'material']) &&
             data.id is string && data.id.size() > 0 &&
             data.material is string && data.material.size() > 0 &&
             (!('qty' in data) || data.qty is number) &&
             (!('totalAmount' in data) || data.totalAmount is number);
    }

    function isValidHealthFacilityRecord(data) {
      return data.keys().hasAll(['id', 'customer', 'customerDescription']) &&
             data.id is string &&
             data.customer is string &&
             data.customerDescription is string;
    }

    function isValidMasterDataLog(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'fileName', 'uploadedAt']) &&
             data.userId == request.auth.uid;
    }

    // Collection Matches
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      match /inventory/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(itemId) && isValidMedicalDeviceItem(incoming());
        allow delete: if isOwner(userId);
      }

      match /healthFacilities/{hfId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(hfId) && isValidHealthFacilityRecord(incoming());
        allow delete: if isOwner(userId);
      }

      match /materialMaster/{matId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(matId);
        allow delete: if isOwner(userId);
      }

      match /multipleStock/{stockId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(stockId);
        allow delete: if isOwner(userId);
      }

      match /receivingData/{recId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(recId);
        allow delete: if isOwner(userId);
      }

      match /distributionData/{distId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(distId);
        allow delete: if isOwner(userId);
      }

      match /programMdRecords/{progId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(progId);
        allow delete: if isOwner(userId);
      }

      match /dspWorkflows/{dspId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(dspId);
        allow delete: if isOwner(userId);
      }

      match /masterDataLogs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidMasterDataLog(incoming());
        allow delete: if isOwner(userId);
      }

      match /uploadedFiles/{fileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(fileId);
        allow delete: if isOwner(userId);
      }
    }
    
    // Admin override (if needed)
    match /admins/{adminId} {
       allow read: if isSignedIn();
    }
  }
}
