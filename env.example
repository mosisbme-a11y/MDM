# ==============================================================================
# SUPABASE CONFIGURATION  (copy this file to ".env" and fill in your own values)
# Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Project URL, e.g. https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public "anon" key. Safe for the browser ONLY because Row Level Security is
# locked down by supabase_auth_and_sync.sql.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# SERVER-ONLY secret "service_role" key. Used by server.js to verify logins,
# create users and write synced data. NEVER put it in a VITE_ variable, never
# commit it, never paste it in chat/screenshots.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-here
