# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# In your Supabase Dashboard: Go to Project Settings -> API (or API Keys)

# 1. Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key (safe for frontend / browser requests)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key-here

# 3. (Optional) Service Role Secret Key (Server-side backend API routes only, never on client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-key-here
